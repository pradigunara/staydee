<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome silhouette of the launcher artwork (lens rings, pupil, swirl). Notification small
     icons and themed launcher icons use only the alpha channel, so the full-colour art can't be
     used there. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- outer ring -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,2.5a9.5,9.5 0,1 1,0 19a9.5,9.5 0,1 1,0 -19zM12,4a8,8 0,1 0,0 16a8,8 0,1 0,0 -16z" />
    <!-- iris ring -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,7a5,5 0,1 1,0 10a5,5 0,1 1,0 -10zM12,8.4a3.6,3.6 0,1 0,0 7.2a3.6,3.6 0,1 0,0 -7.2z" />
    <!-- pupil -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,10.1a1.9,1.9 0,1 1,0 3.8a1.9,1.9 0,1 1,0 -3.8z" />
    <!-- swirl between the rings -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.1"
        android:strokeLineCap="round"
        android:pathData="M5.6,9.4A6.5,6.5 0,0 1,14.6 5.6M18.4,14.6A6.5,6.5 0,0 1,9.4 18.4" />
</vector>
